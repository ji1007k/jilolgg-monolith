### 서버 접근용 환경변수
# 이 파일을 .env.development 로 복사해서 쓴다. (.env.local 이 있으면 그쪽이 먼저 로드된다)

# 프로젝트 모드
NODE_ENV=development

# SSL 인증서 — npm run dev(Express 커스텀 서버)에서 USE_HTTPS=true 일 때만 필요.
# 저장소에 인증서를 포함하지 않으므로 직접 만들어야 한다. mkcert 사용 예:
#   mkcert -key-file src/config/https/localhost-key.pem -cert-file src/config/https/localhost.pem localhost
# 인증서를 만들기 싫으면 USE_HTTPS=false 로 두거나 npm run nextdev 를 쓴다.
SSL_KEY_PATH=src/config/https/localhost-key.pem
SSL_CERT_PATH=src/config/https/localhost.pem

# API 서버 URL
# 로컬 백엔드는 application-dev.properties 에서 server.ssl.enabled=false 이므로 http 다.
API_URL_LOCAL=http://localhost:8080
WS_URL_LOCAL=ws://localhost:8080

# USE_REMOTE_API=true 일 때 사용할 원격 주소
API_URL_PROD=https://jilolgg.up.railway.app
WS_URL_PROD=wss://jilolgg.up.railway.app

### 클라이언트 접근 가능한 환경변수 (NEXT_PUBLIC_)
NEXT_PUBLIC_NODE_ENV=development

### .env.local 에서 주로 덮어쓰는 값들
# PORT=3000
# USE_HTTPS=false
# USE_REMOTE_API=false
# USE_REVERSE_PROXY=false
